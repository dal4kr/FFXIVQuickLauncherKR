<Window x:Class="XIVLauncher.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:korea="clr-namespace:XIVLauncher.Common.Korea;assembly=XIVLauncher.Common"
        xmlns:dalamud="clr-namespace:XIVLauncher.Common.Korea.Dalamud;assembly=XIVLauncher.Common"
        Title="FFXIVLauncherKR" Width="620" Height="800" MinWidth="530" MinHeight="610"
        Background="{StaticResource WindowSurface}" Foreground="{StaticResource PrimaryText}" FontFamily="Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing"
        Icon="pack://application:,,,/Resources/dalamud_icon.ico">
  <Window.Resources>
    <Style x:Key="NavigationTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Surface}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectedTabSurface}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="26,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="{StaticResource BannerSurface}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="12" Padding="18,15" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="FFXIVLauncherKR" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="파이널판타지 XIV · 한국 서버" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>
        <Button x:Name="InjectDalamudButton" Grid.Column="1" Content="Dalamud 수동 연결" Click="InjectDalamud_Click"
                VerticalAlignment="Center" Margin="12,0,0,0" Padding="10,8" FontSize="12"
                ToolTip="실행 중인 게임에 Dalamud를 연결합니다. 수동 연결은 DllInject 방식을 사용합니다." />
      </Grid>
    </Border>
    <Border x:Name="ErrorBanner" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource ErrorSurface}" BorderBrush="{StaticResource ErrorOutline}"
            BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource ErrorOutline}" Width="23" Height="23" CornerRadius="12" VerticalAlignment="Top">
          <TextBlock Text="!" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="오류가 발생했습니다" Foreground="{StaticResource ErrorText}" FontSize="14" FontWeight="SemiBold" />
          <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
            <TextBlock x:Name="ErrorMessage" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
          </ScrollViewer>
        </StackPanel>
        <Button Grid.Column="2" Content="닫기" Click="DismissError_Click" ToolTip="오류 메시지 닫기" VerticalAlignment="Top" Margin="12,0,0,0"
                MinHeight="28" Padding="8,4" FontSize="12" Background="Transparent" Foreground="{StaticResource ErrorText}" BorderBrush="{StaticResource ErrorOutline}" />
      </Grid>
    </Border>
    <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <Border Background="{StaticResource NavigationSurface}" BorderBrush="{StaticResource Outline}" BorderThickness="1,1,1,0" CornerRadius="9,9,0,0">
              <TabPanel IsItemsHost="True" Margin="7,5,7,0" KeyboardNavigation.TabIndex="1" />
            </Border>
            <Border Grid.Row="1" Background="{StaticResource ContentSurface}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="0,0,9,9" Padding="16,0">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem x:Name="GameTab" Header="게임 실행" IsSelected="True" Style="{StaticResource NavigationTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,4">
            <Grid Margin="0,0,0,14">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="로그인 방식" Margin="0,0,0,7" />
              <TextBlock Grid.Column="1" Text="저장된 계정" Margin="0,0,0,7" />
              <ComboBox x:Name="LoginProviderPicker" Grid.Row="1" SelectedValuePath="Tag" SelectedIndex="0" Margin="0,0,10,0" MinHeight="34"
                        AutomationProperties.Name="로그인 방식" SelectionChanged="LoginProvider_Changed">
                <ComboBoxItem Content="액토즈 계정" Tag="{x:Static korea:LoginProvider.Actoz}" />
                <ComboBoxItem Content="네이버 계정" Tag="{x:Static korea:LoginProvider.Naver}" />
              </ComboBox>
              <ComboBox x:Name="AccountPicker" Grid.Row="1" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="AccountSelection_Changed" MinHeight="34" />
              <Button x:Name="AddAccountButton" Grid.Row="1" Grid.Column="2" Content="계정 추가" Margin="8,0,0,0" Click="AddAccount_Click" />
            </Grid>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="로그인 상태" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="SessionSummary" Text="저장된 세션이 없습니다." Margin="0,7,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionDate" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="NewLoginButton" Content="새로 로그인" Click="NewLogin_Click" Margin="0,0,8,0" />
                  <Button x:Name="DeleteSessionButton" Content="계정 삭제" Click="DeleteSession_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock x:Name="AccountStorageWarning" Foreground="#F0BC78" TextWrapping="Wrap" Margin="0,0,0,8">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <StackPanel x:Name="LoginPanel">
              <StackPanel x:Name="ActozLoginPanel">
                <TextBlock Text="액토즈 계정 로그인" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="아이디" Margin="0,0,0,6" />
                    <TextBox x:Name="UserName" AutomationProperties.Name="액토즈 아이디" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="비밀번호" Margin="0,0,0,6" />
                    <PasswordBox x:Name="Password" AutomationProperties.Name="비밀번호" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="자동 입력 방지" Margin="0,13,0,7" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Border Background="White" Height="52" Padding="3"><Image x:Name="CaptchaImage" Stretch="Uniform" AutomationProperties.Name="자동 입력 방지 이미지" /></Border>
                  <Button x:Name="RefreshCaptchaButton" Grid.Column="1" Content="새로고침" Margin="8,0,10,0" Click="RefreshCaptcha_Click" />
                  <TextBox x:Name="CaptchaCode" Grid.Column="2" MaxLength="5" VerticalAlignment="Center" AutomationProperties.Name="자동 입력 방지 문자 5자리" />
                </Grid>
                <TextBlock Text="이미지의 문자 5자리를 입력해 주세요. 비밀번호는 저장하지 않습니다."
                           Foreground="{StaticResource Muted}" Margin="0,7,0,12" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="NaverLoginHint" Text="네이버 로그인 버튼을 눌러 별도 창에서 인증해 주세요. 게임 OTP가 필요한 계정은 인증번호를 추가로 입력합니다."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" Visibility="Collapsed" />
            </StackPanel>

            <CheckBox x:Name="SaveSession" Content="로그인 세션 저장"
                      ToolTip="로그인 상태를 저장해 다음 실행 시 자동으로 로그인합니다. 비밀번호는 저장하지 않습니다." Margin="0,3,0,24"
                      Checked="SaveSession_Changed" Unchecked="SaveSession_Changed" />
            <CheckBox x:Name="AutoLaunch" Content="런처 시작 시 게임 자동 실행" IsChecked="False" Margin="0,0,0,4"
                      ToolTip="저장된 로그인 세션으로 게임을 실행합니다. Shift 키를 누른 채 런처를 켜면 이번에는 자동 실행을 건너뜁니다."
                      Checked="AutoLaunch_Changed" Unchecked="AutoLaunch_Changed" />
            <TextBlock Text="Shift 키를 누른 채 런처를 실행하면 게임 자동 실행을 한 번 건너뜁니다."
                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,14" />
            <CheckBox x:Name="RunAsAdministrator" Content="관리자 권한으로 실행" IsChecked="False" Margin="0,0,0,16"
                      ToolTip="켜면 관리자 권한으로 재시작합니다. 해제는 다음 실행부터 적용됩니다."
                      Checked="Administrator_Changed" Unchecked="Administrator_Changed" />
            <Button x:Name="LaunchButton" Content="로그인" FontSize="16" FontWeight="SemiBold" MinHeight="48"
                    Background="{StaticResource Accent}" Foreground="#10223B" BorderBrush="{StaticResource Accent}" Click="Launch_Click" IsDefault="True" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="GameUpdateTab" Header="게임 설치 / 업데이트" Style="{StaticResource NavigationTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,4">
            <TextBlock Text="게임 설치 / 업데이트" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="설치된 게임 폴더를 선택하거나 새 폴더를 지정해 게임을 설치하세요. 게임 실행에도 이 경로를 사용합니다."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />
            <TextBlock Text="게임 설치 경로" Margin="0,0,0,7" />
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="GameDirectory" AutomationProperties.Name="게임 설치 경로" LostFocus="GameDirectory_LostFocus" />
              <Button x:Name="BrowseButton" Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Click="Browse_Click" />
            </Grid>
            <TextBlock x:Name="GameVersionSummary" Text="버전을 확인해 주세요." TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock x:Name="GameUpdateStatus" Text="KR 서버의 파일 목록과 게임 패치 버전을 확인합니다." TextWrapping="Wrap" Margin="0,0,0,16" />
            <ProgressBar x:Name="GameUpdateProgressBar" Height="12" Minimum="0" Maximum="100" Margin="0,0,0,18" />
            <WrapPanel>
              <Button x:Name="CheckGameUpdateButton" Content="업데이트 확인" Click="CheckGameUpdate_Click" Margin="0,0,8,8" />
              <Button x:Name="InstallGameButton" Content="게임 설치 / 업데이트" Click="InstallGame_Click" Margin="0,0,8,8" />
              <Button x:Name="CancelGameUpdateButton" Content="취소" Click="CancelGameUpdate_Click" Margin="0,0,0,8" IsEnabled="False" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="DalamudTab" Header="Dalamud 설정" Style="{StaticResource NavigationTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,4">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="UseDalamud" Content="KR Dalamud 사용" FontWeight="SemiBold"
                          Checked="DalamudSetting_Changed" Unchecked="DalamudSetting_Changed" />
                <StackPanel x:Name="DalamudSettingsPanel" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                      <Button x:Name="CheckDalamudButton" Content="업데이트 확인" Click="CheckDalamud_Click" Margin="0,0,8,0" />
                      <Button x:Name="ReinstallDalamudButton" Content="다시 설치" Click="ReinstallDalamud_Click"
                              ToolTip="같은 버전도 새로 받습니다. Dalamud 설정과 플러그인은 유지됩니다." />
                    </StackPanel>
                    <TextBlock Text="게임 실행 없이 최신 배포를 확인하고 업데이트합니다. 직접 빌드 사용 중에는 배포 업데이트를 하지 않습니다."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <CheckBox x:Name="UseLocalDalamud" Content="직접 빌드한 Dalamud 사용" Margin="0,0,0,9"
                              Checked="DalamudSetting_Changed" Unchecked="DalamudSetting_Changed" />
                    <StackPanel x:Name="LocalDalamudPanel">
                      <TextBlock Text="빌드 출력 폴더" Margin="0,0,0,6" />
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="LocalDalamudDirectory" AutomationProperties.Name="Dalamud 빌드 출력 폴더" />
                        <Button Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Click="BrowseDalamud_Click" />
                      </Grid>
                      <TextBlock Text="로컬 빌드 대상 게임 버전" Margin="0,0,0,6" />
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="LocalDalamudGameVersion" AutomationProperties.Name="로컬 빌드 대상 게임 버전" />
                        <Button Grid.Column="1" Content="현재 버전" Margin="8,0,0,0" Click="UseCurrentGameVersion_Click" />
                      </Grid>
                      <TextBlock Text="이 빌드가 지원하는 게임 버전을 지정하세요. 게임 패치 후에는 새 빌드와 대상 버전을 확인해 주세요."
                                 Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    </StackPanel>
                    <TextBlock Text="연결 방식" Margin="0,0,0,6" />
                    <ComboBox x:Name="DalamudLoadMethodPicker" SelectedValuePath="Tag" Margin="0,0,0,12"
                              AutomationProperties.Name="Dalamud 연결 방식" SelectionChanged="DalamudLoadMethod_Changed">
                      <ComboBoxItem Content="DllInject (기본값 · 게임 실행 후 연결)" Tag="{x:Static dalamud:DalamudLoadMethod.DllInject}" />
                      <ComboBoxItem Content="EntryPoint (게임 시작 단계에서 연결)" Tag="{x:Static dalamud:DalamudLoadMethod.EntryPoint}" />
                    </ComboBox>
                    <CheckBox x:Name="DalamudNoPlugins" Content="플러그인 없이 Dalamud 시작" Margin="0,0,0,9" />
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="초기화 지연(ms)" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <TextBox x:Name="DalamudDelay" Width="90" MaxLength="5" AutomationProperties.Name="Dalamud 초기화 지연" />
                    </StackPanel>
                    <TextBlock Text="게임 실행 전에 KR Dalamud와 리소스를 한 번 확인합니다."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="BackupTab" Header="백업 / 복원" Style="{StaticResource NavigationTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,4">
            <TextBlock Text="백업 / 복원" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="런처 설정, 저장된 계정, Dalamud 설정·플러그인을 파일 하나로 백업하고 복원합니다."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="BackupIncludeGameSettings" Content="게임·캐릭터 설정도 백업" IsChecked="False" Margin="0,0,0,10" />
                <TextBlock Text="단축바·매크로·화면 설정 등을 포함합니다. 스크린샷과 게임 설치 파일은 포함하지 않습니다."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Button x:Name="CreateBackupButton" Content="백업 만들기" Click="CreateBackup_Click" MinHeight="48" Margin="0,0,6,0" />
                  <Button x:Name="RestoreBackupButton" Grid.Column="1" Content="백업 복원" Click="RestoreBackup_Click" MinHeight="48" Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="게임을 종료한 상태에서 백업·복원을 진행해 주세요. 복원할 때는 백업에 포함된 파일을 덮어쓰며, 그 외 파일은 유지합니다."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="계정 로그인 정보는 현재 Windows 사용자 환경에서 암호화되어 있습니다. 다른 환경에 복원하면 다시 로그인해야 할 수 있습니다."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="일부 플러그인이 외부 폴더에 저장한 데이터는 백업에 포함되지 않을 수 있습니다."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3">
      <ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="Status" Text="로그인 화면을 준비합니다." Foreground="{StaticResource Muted}"
                 TextWrapping="Wrap" Margin="0,13,0,0" MinHeight="40">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="LauncherVersion" Foreground="#8394AD" FontSize="11" Margin="0,14,0,0" />
    </StackPanel>
  </Grid>
</Window>
